{
  "model": "glm-5.3-flash",
  "base_url": "https://api.z.ai/api/paas/v4/",
  "api_key_env": "ZAI_API_KEY",
  "verify_model": null,
  "command_timeout": 120,
  "max_output_chars": 6000,
  "max_loop_iters": 25,
  "max_verify_iters": 8,
  "budget_tokens": 2000000,
  "stop_on_fail": false,
  "exclude_dirs": [
    ".git",
    "node_modules",
    "__pycache__",
    ".venv",
    "venv",
    "dist",
    "build",
    ".next",
    ".cache",
    ".loopgraph"
  ],
  "blocked_patterns": [
    "\\brm\\s+(-\\w*\\s+)*-?[rf]{1,2}\\b.*\\s/[^\\s]*",
    "\\brd\\s+/s",
    "\\bdel\\s+/[sq]",
    "\\bformat\\s+",
    "\\bshutdown\\b",
    "\\bgit\\s+push\\b",
    "\\bgit\\s+reset\\s+--hard\\b",
    "\\bgit\\s+clean\\b",
    "\\btaskkill\\b",
    "\\breg\\s+(add|delete)\\b",
    "\\bmkfs\\b",
    "\\bdd\\s+if=",
    "\\bsudo\\b",
    "\\bcurl\\b.*\\|\\s*(ba)?sh",
    "\\bInvoke-Expression\\b",
    "\\bchpasswd\\b",
    "\\bnet\\s+user\\b"
  ]
}